edu_map <- c(
"No schooling completed" = 0,
"Nursery school to grade 4" = 2,
"Grade 5 to grade 8" = 6,
"Grade 9" = 9,
"Grade 10" = 10,
"Grade 11" = 11,
"12th grade, no diploma" = 12,
"Regular high school diploma" = 12,
"GED or alternative credential" = 12,
"Some college, but less than 1 year" = 13,
"1 or more years of college credit, no degree" = 14,
"Associate's degree, type not specified" = 14,
"Associate's degree, academic program" = 14,
"Associate's degree, occupational program" = 14,
"Bachelor's degree" = 16,
"Master's degree" = 18,
"Professional degree beyond bachelor's" = 19,
"Doctoral degree" = 20
)
View(acs)
table(acs$SCHL_label)
table(acs$RAC1P_label)
table(acs$ESR_label)
# Recode years of education from SCHL_label
edu_map <- c(
"No schooling completed" = 0,
"Nursery school, preschool" = 1,
"Kindergarten" = 1,
"Grade 1" = 2, "Grade 2" = 3, "Grade 3" = 4, "Grade 4" = 5,
"Grade 5" = 6, "Grade 6" = 7, "Grade 7" = 8, "Grade 8" = 9,
"Grade 9" = 10, "Grade 10" = 11, "Grade 11" = 12,
"12th grade - no diploma" = 12,
"Regular high school diploma" = 12,
"GED or alternative credential" = 12,
"Some college, but less than 1 year" = 13,
"1 or more years of college credit, no degree" = 14,
"Associate's degree" = 14,
"Bachelor's degree" = 16,
"Master's degree" = 18,
"Professional degree beyond a bachelor's degree" = 19,
"Doctorate degree" = 20
)
# Apply recoding and prepare race variable
acs_clean <- acs %>%
mutate(
income = as.numeric(PINCP),
age = as.numeric(AGEP),
education = edu_map[SCHL_label],
race = case_when(
RAC1P_label == "White alone" ~ "White",
RAC1P_label == "Black or African American alone" ~ "Black",
RAC1P_label %in% c(
"American Indian alone",
"Alaska Native alone",
"American Indian and Alaska Native tribes specified; or American Indian or Alaska Native, not specified and no other races"
) ~ "Native",
RAC1P_label == "Asian alone" ~ "Asian",
TRUE ~ NA_character_
),
log_income = log(income)
) %>%
filter(
age >= 25, age <= 64,
!is.na(education),
income > 0,
race %in% c("White", "Black", "Native", "Asian"),
ESR == "Civilian employed, at work"
) %>%
select(log_income, education, race)
